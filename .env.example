# MeshTalk desktop — all optional. Never commit real values.

# Run an isolated instance with its own data directory (same as --profile=<name>).
# MESHTALK_PROFILE=alice

# Use an explicit absolute data directory instead (takes precedence; used by E2E tests).
# MESHTALK_DATA_DIR=/tmp/meshtalk-dev

# Log level: debug | info | warn | error
# MESHTALK_LOG_LEVEL=info

# PeerLink port (default 47820; any free port if taken).
# MESHTALK_PEER_PORT=47820

