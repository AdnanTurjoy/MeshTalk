{
  "name": "meshtalk",
  "productName": "MeshTalk",
  "version": "0.1.0",
  "description": "LAN-first, local-first desktop communication",
  "homepage": "https://meshtalk.invalid",
  "private": true,
  "license": "UNLICENSED",
  "author": "MeshTalk contributors",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --project integration",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --config electron-builder.release.yml",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.release.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.release.yml",
    "dist:linux": "npm run build && electron-builder --linux --config electron-builder.release.yml",
    "dist:dir": "npm run build && electron-builder --dir",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dist:dir:release": "npm run build && electron-builder --dir --config electron-builder.release.yml"
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.4",
    "drizzle-orm": "^0.45.4",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
